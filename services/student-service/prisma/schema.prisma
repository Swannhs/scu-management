generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  DROPPED
  PROBATION
}

model Student {
  id              String        @id @default(uuid())
  tenantId        String
  keycloakId      String?       @unique // Optional if user-auth is separate but linked
  
  // Identification
  studentId       String        @unique // Institutional identifier (e.g. ROLL NO / gr_no)
  idNumber        String?       // National ID Card Number
  visaInfo        String?       // Visa Information
  
  // Personal Info
  firstName       String
  middleName      String?
  lastName        String
  email           String
  phone           String?
  dateOfBirth     DateTime?
  gender          String?       // 'm', 'f', 'o'
  bloodGroup      String?       // e.g. A+, O-
  nationality     String?       // Country Code or Name
  address         String?

  // Admission Info
  admissionDate   DateTime      @default(now())
  status          StudentStatus @default(ACTIVE)
  
  // Emergency Contact
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactRelation String?
  
  // Parent/Guardian Info
  parentName      String?
  parentPhone     String?
  parentEmail     String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantId])
  @@index([status])
}
