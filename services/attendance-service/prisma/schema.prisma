generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ATTENDANCE
// ==========================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model AttendanceSession {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  
  // Link to Course Schedule
  courseOfferingId  String    @map("course_offering_id")
  termId            String?   @map("term_id")
  sessionId         String?   @map("session_id") // Link to specific timetable slot if exists
  
  date              DateTime
  startTime         DateTime? @map("start_time")
  endTime           DateTime? @map("end_time")
  
  takenById         String?   @map("taken_by_id") // Faculty/User ID
  isFinalized       Boolean   @default(false) @map("is_finalized")
  
  records           AttendanceRecord[]
  
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@index([tenantId, courseOfferingId])
  @@index([tenantId, date])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                String           @id @default(uuid())
  tenantId          String           @map("tenant_id")
  attendanceSessionId String         @map("attendance_session_id")
  
  studentId         String           @map("student_id")
  status            AttendanceStatus
  remarks           String?
  
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  deletedAt         DateTime?        @map("deleted_at")

  session           AttendanceSession @relation(fields: [attendanceSessionId], references: [id])

  @@unique([attendanceSessionId, studentId])
  @@index([tenantId, studentId])
  @@map("attendance_records")
}
