generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// EXAMS & GRADING
// ==========================================

enum ExamType {
  MIDTERM
  FINAL
  QUIZ
  SUPPLEMENTARY
}

model Exam {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  courseOfferingId  String    @map("course_offering_id")
  
  name              String
  type              ExamType
  date              DateTime
  durationMinutes   Int       @map("duration_minutes")
  totalMarks        Decimal   @map("total_marks") @db.Decimal(5, 2)
  weightagePercent  Decimal   @map("weightage_percent") @db.Decimal(5, 2) // e.g. 30% of final grade
  
  isPublished       Boolean   @default(false) @map("is_published")
  
  marks             ExamMark[]
  
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@index([tenantId, courseOfferingId])
  @@map("exams")
}

model ExamMark {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  examId            String    @map("exam_id")
  studentId         String    @map("student_id")
  
  obtainedMarks     Decimal   @map("obtained_marks") @db.Decimal(5, 2)
  remarks           String?
  
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  exam              Exam      @relation(fields: [examId], references: [id])

  @@unique([examId, studentId])
  @@index([tenantId, studentId])
  @@map("exam_marks")
}

model GradeRule {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  programId         String?   @map("program_id") // Optional specific program override
  
  grade             String    // e.g. "A", "B+"
  minPercentage     Decimal   @map("min_percentage") @db.Decimal(5, 2)
  maxPercentage     Decimal   @map("max_percentage") @db.Decimal(5, 2)
  gradePoint        Decimal   @map("grade_point") @db.Decimal(3, 2) // e.g. 4.0, 3.5
  
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@index([tenantId])
  @@map("grade_rules")
}

model StudentTranscript {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  studentId         String    @map("student_id")
  termId            String    @map("term_id")
  
  gpa               Decimal?  @db.Decimal(3, 2)
  cgpa              Decimal?  @db.Decimal(3, 2)
  totalCredits      Decimal?  @map("total_credits") @db.Decimal(5, 2)
  
  isFinalized       Boolean   @default(false) @map("is_finalized")
  
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@unique([tenantId, studentId, termId])
  @@map("student_transcripts")
}

model FinalGrade {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  courseOfferingId  String    @map("course_offering_id")
  termId            String?   @map("term_id")
  studentId         String    @map("student_id")
  percentage        Decimal   @db.Decimal(5, 2)
  grade             String
  gradePoint        Decimal?  @map("grade_point") @db.Decimal(3, 2)
  computedAt        DateTime  @default(now()) @map("computed_at")

  @@unique([tenantId, courseOfferingId, studentId])
  @@index([tenantId, studentId])
  @@map("final_grades")
}

// ==========================================
// EVENT OUTBOX
// ==========================================

model EventOutbox {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  eventType   String   @map("event_type")
  payload     Json
  
  status      String   @default("PENDING") // PENDING, PUBLISHED
  retries     Int      @default(0)
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@index([tenantId, status])
  @@map("event_outbox")
}
