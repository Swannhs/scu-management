{
  "openapi": "3.0.3",
  "info": { "title": "Course Service API", "version": "1.0.0" },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "parameters": {
      "TenantHeader": { "name": "X-Tenant-ID", "in": "header", "required": true, "schema": { "type": "string" } }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/v1/academic-years": {
      "get": { "summary": "List academic years", "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }] },
      "post": { "summary": "Create academic year", "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }] }
    },
    "/v1/courses": {
      "get": { "summary": "List courses", "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }] },
      "post": { "summary": "Create course", "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }] }
    }
  }
}
