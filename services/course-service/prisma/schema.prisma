generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ACADEMIC STRUCTURE
// ==========================================

model AcademicYear {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  name      String
  code      String
  startDate DateTime  @map("start_date")
  endDate   DateTime  @map("end_date")
  isActive  Boolean   @default(false) @map("is_active")

  terms     AcademicTerm[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("academic_years")
}

model Department {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  name        String
  code        String
  headId      String?   @map("head_id") // Faculty ID reference

  programs    Program[]

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
}

model Program {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  departmentId  String    @map("department_id")

  name          String
  code          String
  degreeLevel   String?   @map("degree_level") // UG, PG, Diploma
  durationMonths Int?     @map("duration_months")
  
  courses       Course[]
  
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  department    Department @relation(fields: [departmentId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("programs")
}

model Course {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  programId     String?   @map("program_id") // Optional owner program
  
  name          String
  code          String
  credits       Float     @default(0)
  description   String?
  
  offerings     CourseOffering[]
  
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  program       Program?  @relation(fields: [programId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("courses")
}

model AcademicTerm {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  academicYearId String   @map("academic_year_id")
  name          String    // e.g. "Fall 2024"
  code          String
  startDate     DateTime  @map("start_date")
  endDate       DateTime  @map("end_date")
  isActive      Boolean   @default(false) @map("is_active")
  
  offerings     CourseOffering[]
  academicYear  AcademicYear @relation(fields: [academicYearId], references: [id])
  
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("academic_terms")
}

model Room {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  name        String
  code        String
  capacity    Int?
  building    String?

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("rooms")
}

// ==========================================
// SCHEDULING & OFFERINGS (The "Class")
// ==========================================

model CourseOffering {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  courseId      String    @map("course_id")
  termId        String    @map("term_id")

  sectionName   String    @default("A") // section code / name (legacy compatibility)
  facultyId     String?   @map("faculty_id") // Primary instructor
  roomId        String?   @map("room_id")
  schedule      String?
  status        String    @default("active")
  capacity      Int?

  enrollments   CourseEnrollment[]
  sessions      CourseSession[]
  
  // LMS Relationships
  materials     LMSMaterial[]
  assignments   LMSAssignment[]

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  course        Course    @relation(fields: [courseId], references: [id])
  term          AcademicTerm @relation(fields: [termId], references: [id])

  @@index([tenantId, termId])
  @@index([courseId])
  @@map("course_offerings")
}

model CourseEnrollment {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  courseOfferingId  String    @map("course_offering_id")
  studentId         String    @map("student_id")
  
  enrolledAt        DateTime  @default(now()) @map("enrolled_at")
  status            String    @default("ENROLLED") // ENROLLED, DROPPED, COMPLETED
  
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  offering          CourseOffering @relation(fields: [courseOfferingId], references: [id])

  @@unique([tenantId, courseOfferingId, studentId])
  @@index([tenantId, studentId])
  @@map("course_enrollments")
}

model CourseSession {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  courseOfferingId  String    @map("course_offering_id")
  
  title             String?
  date              DateTime? // For one-off or specific date sessions
  dayOfWeek         String?   // MONDAY, TUESDAY (for recurring)
  startTime         String    // 09:00
  endTime           String    // 10:00
  roomId            String?   // Reference to infrastructure/room
  
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  offering          CourseOffering @relation(fields: [courseOfferingId], references: [id])

  @@index([tenantId])
  @@index([courseOfferingId])
  @@map("course_sessions")
}

// ==========================================
// LMS FEATURES (Content & Assignments)
// ==========================================

enum MaterialType {
  FILE
  LINK
  TEXT
  VIDEO
}

model LMSMaterial {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  courseOfferingId  String    @map("course_offering_id")
  
  title             String
  description       String?
  type              MaterialType
  contentUrl        String?   @map("content_url") // S3 URL or Link
  textContent       String?   @map("text_content") // For rich text notes
  
  isVisible         Boolean   @default(true) @map("is_visible")
  
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  offering          CourseOffering @relation(fields: [courseOfferingId], references: [id])

  @@index([tenantId, courseOfferingId])
  @@map("lms_materials")
}

model LMSAssignment {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  courseOfferingId  String    @map("course_offering_id")
  
  title             String
  description       String?
  dueDate           DateTime? @map("due_date")
  maxMarks          Decimal?  @map("max_marks") @db.Decimal(5, 2)
  
  submissions       LMSSubmission[]
  
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  offering          CourseOffering @relation(fields: [courseOfferingId], references: [id])

  @@index([tenantId, courseOfferingId])
  @@map("lms_assignments")
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
  LATE
}

model LMSSubmission {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  assignmentId      String    @map("assignment_id")
  studentId         String    @map("student_id")
  
  contentUrl        String?   @map("content_url")
  textContent       String?   @map("text_content")
  
  submittedAt       DateTime? @map("submitted_at")
  status            SubmissionStatus @default(DRAFT)
  
  // Grading
  obtainedMarks     Decimal?  @map("obtained_marks") @db.Decimal(5, 2)
  feedback          String?
  gradedById        String?   @map("graded_by_id") // Faculty ID
  gradedAt          DateTime? @map("graded_at")
  
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  assignment        LMSAssignment @relation(fields: [assignmentId], references: [id])

  @@unique([tenantId, assignmentId, studentId])
  @@index([tenantId, studentId])
  @@map("lms_submissions")
}

// ==========================================
// EVENT OUTBOX
// ==========================================

model EventOutbox {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  eventType   String   @map("event_type")
  payload     Json
  
  status      String   @default("PENDING") // PENDING, PUBLISHED
  retries     Int      @default(0)
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@index([tenantId, status])
  @@map("event_outbox")
}
