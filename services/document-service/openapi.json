{
  "openapi": "3.0.3",
  "info": {
    "title": "Document Service API",
    "version": "1.0.0",
    "description": "Tenant-aware document metadata and content service."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "TenantHeader": {
        "name": "X-Tenant-ID",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/files/initiate-upload": {
      "post": {
        "summary": "Create file metadata and return an upload URL"
      }
    },
    "/v1/files/complete-upload": {
      "post": {
        "summary": "Mark an uploaded file as active"
      }
    },
    "/v1/files/{fileId}": {
      "get": {
        "summary": "Get file metadata"
      },
      "delete": {
        "summary": "Soft-delete a file"
      }
    },
    "/v1/files/{fileId}/content": {
      "put": {
        "summary": "Upload binary content for a file"
      },
      "get": {
        "summary": "Download file content"
      }
    },
    "/v1/files/{fileId}/download-url": {
      "get": {
        "summary": "Get a download URL for file content"
      }
    },
    "/v1/files/{fileId}/share": {
      "post": {
        "summary": "Grant access to a file"
      }
    }
  }
}
