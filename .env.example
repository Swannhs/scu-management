# =============================================================================
# SCU Management Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values before running locally.
# NEVER commit the .env file. It is listed in .gitignore.
#
# Variables marked [REQUIRED in production] must be set to strong, unique
# values in any non-development environment. Using the dev defaults in
# production is a security vulnerability.
# =============================================================================

# -----------------------------------------------------------------------------
# JWT / Auth
# [REQUIRED in production] — must be a long, random string
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-in-development

# -----------------------------------------------------------------------------
# Keycloak
# Canonical realm: scu
# [REQUIRED in production] — change admin credentials before deploying
# -----------------------------------------------------------------------------
KEYCLOAK_REALM=scu
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloakpass
KEYCLOAK_PORT=8080

# -----------------------------------------------------------------------------
# Per-service Keycloak client secrets
# [REQUIRED in production]
# -----------------------------------------------------------------------------
COURSE_KEYCLOAK_CLIENT_SECRET=change-me-in-development
ASSESSMENT_KEYCLOAK_CLIENT_SECRET=change-me-in-development
CAMPUS_SOCIAL_KEYCLOAK_CLIENT_SECRET=change-me-in-development

# -----------------------------------------------------------------------------
# Legacy social service (Reverb) — only used with --profile legacy-social
# [REQUIRED in production if using legacy-social profile]
# -----------------------------------------------------------------------------
REVERB_APP_ID=scu-reverb
REVERB_APP_KEY=change-me-in-development
REVERB_APP_SECRET=change-me-in-development

# -----------------------------------------------------------------------------
# Per-service database credentials
# [REQUIRED in production] — use strong, unique passwords per service
# -----------------------------------------------------------------------------
SOCIAL_DB_USER=socialuser
SOCIAL_DB_PASSWORD=socialpass

GRADES_DB_USER=gradesuser
GRADES_DB_PASSWORD=gradespass

ATTENDANCE_DB_USER=attendanceuser
ATTENDANCE_DB_PASSWORD=attendancepass

COURSE_DB_USER=courseuser
COURSE_DB_PASSWORD=coursepass

FINANCE_DB_USER=financeuser
FINANCE_DB_PASSWORD=financepass

LIBRARY_DB_USER=libraryuser
LIBRARY_DB_PASSWORD=librarypass

FACULTY_DB_USER=facultyuser
FACULTY_DB_PASSWORD=facultypass

HOSTEL_DB_USER=hosteluser
HOSTEL_DB_PASSWORD=hostelpass

PARENT_DB_USER=parentuser
PARENT_DB_PASSWORD=parentpass

ADMIN_DB_USER=adminuser
ADMIN_DB_PASSWORD=adminpass

TRANSPORT_DB_USER=transportuser
TRANSPORT_DB_PASSWORD=transportpass

ENROLLMENT_DB_USER=enrollmentuser
ENROLLMENT_DB_PASSWORD=enrollmentpass

USER_DB_USER=userauthuser
USER_DB_PASSWORD=userauthpass

ASSESSMENT_DB_USER=assessmentuser
ASSESSMENT_DB_PASSWORD=assessmentpass

DOCUMENT_DB_USER=documentuser
DOCUMENT_DB_PASSWORD=documentpass

# -----------------------------------------------------------------------------
# Infrastructure ports (local development only)
# -----------------------------------------------------------------------------
REDIS_PORT=6379
MONGO_PORT=27017
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Image registry (used by docker-compose.prod.yml)
# -----------------------------------------------------------------------------
REGISTRY=ghcr.io/your-org
TAG=latest
