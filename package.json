{
  "name": "university-management-mvp",
  "version": "1.0.0",
  "description": "University Management System MVP - Microservices Architecture",
  "private": true,
  "workspaces": [
    "services/*",
    "libs/*"
  ],
  "scripts": {
    "build:shared": "cd libs/shared && npm run build",
    "build:all": "npm run build:shared && npm run build:services",
    "build:services": "npm run build:user && npm run build:course && npm run build:attendance && npm run build:assessment && npm run build:grades && npm run build:campus-social",
    "build:mvp": "npm run build:all",
    "build:user": "cd services/user-service && npm run build",
    "build:course": "cd services/course-service && npm run build",
    "build:attendance": "cd services/attendance-service && npm run build",
    "build:assessment": "cd services/assessment-service && npm run build",
    "build:grades": "cd services/grades-service && npm run build",
    "build:campus-social": "cd services/campus-social-service && npm run build",
    "dev:user": "cd services/user-service && npm run start:dev",
    "dev:course": "cd services/course-service && npm run start:dev",
    "dev:attendance": "cd services/attendance-service && npm run start:dev",
    "dev:assessment": "cd services/assessment-service && npm run start:dev",
    "dev:grades": "cd services/grades-service && npm run start:dev",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "smoke:traefik": "bash scripts/smoke-traefik.sh",
    "prisma:generate:user": "cd services/user-service && npx prisma generate",
    "prisma:generate:course": "cd services/course-service && npx prisma generate",
    "prisma:generate:attendance": "cd services/attendance-service && npx prisma generate",
    "prisma:generate:assessment": "cd services/assessment-service && npx prisma generate",
    "prisma:generate:grades": "cd services/grades-service && npx prisma generate",
    "prisma:generate:all": "npm run prisma:generate:user && npm run prisma:generate:course && npm run prisma:generate:attendance && npm run prisma:generate:assessment && npm run prisma:generate:grades"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
