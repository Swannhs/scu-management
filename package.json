{
  "name": "university-management-mvp",
  "version": "1.0.0",
  "description": "University Management System MVP - Microservices Architecture",
  "private": true,
  "workspaces": [
    "services/*",
    "libs/*"
  ],
  "scripts": {
    "build:shared": "cd libs/shared && npm run build",
    "build:all": "npm run build:shared && npm run build:services",
    "build:services": "npm run build:user && npm run build:academic && npm run build:student && npm run build:attendance && npm run build:examination && npm run build:fee",
    "build:user": "cd services/user-service && npm run build",
    "build:academic": "cd services/academic-service && npm run build",
    "build:student": "cd services/student-service && npm run build",
    "build:attendance": "cd services/attendance-service && npm run build",
    "build:examination": "cd services/examination-service && npm run build",
    "build:fee": "cd services/fee-service && npm run build",
    "dev:user": "cd services/user-service && npm run start:dev",
    "dev:academic": "cd services/academic-service && npm run start:dev",
    "dev:student": "cd services/student-service && npm run start:dev",
    "dev:attendance": "cd services/attendance-service && npm run start:dev",
    "dev:examination": "cd services/examination-service && npm run start:dev",
    "dev:fee": "cd services/fee-service && npm run start:dev",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "smoke:traefik": "bash scripts/smoke-traefik.sh",
    "prisma:generate:user": "cd services/user-service && npx prisma generate",
    "prisma:generate:academic": "cd services/academic-service && npx prisma generate",
    "prisma:generate:student": "cd services/student-service && npx prisma generate",
    "prisma:generate:attendance": "cd services/attendance-service && npx prisma generate",
    "prisma:generate:examination": "cd services/examination-service && npx prisma generate",
    "prisma:generate:fee": "cd services/fee-service && npx prisma generate",
    "prisma:generate:all": "npm run prisma:generate:user && npm run prisma:generate:academic && npm run prisma:generate:student && npm run prisma:generate:attendance && npm run prisma:generate:examination && npm run prisma:generate:fee"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
